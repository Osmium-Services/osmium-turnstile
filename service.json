{
    "id": "turnstile",
    "name": "Cloudflare Turnstile",
    "version": "1.1.0",
    "description": "Spam protection for forms via Cloudflare Turnstile - free, no DNS dependency, admin-editable site/secret key and widget mode",
    "category": "security-privacy",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",

    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": []
    },

    "autoload": [
        "models"
    ],

    "csp": {
        "script-src": ["https://challenges.cloudflare.com"],
        "frame-src": ["https://challenges.cloudflare.com"]
    },

    "migrations": "migrations/",

    "hooks": {
        "form.verify": [
            "Osmium\\Services\\Turnstile\\Models\\TurnstileHooks::verify"
        ],
        "form.widget": [
            "Osmium\\Services\\Turnstile\\Models\\TurnstileHooks::widget"
        ]
    },

    "admin": {
        "menu": {
            "section": "Content",
            "items": [
                {
                    "id": "turnstile",
                    "label": "Turnstile",
                    "icon": "bx bx-shield-quarter",
                    "route": "admin/settings/turnstile",
                    "activePattern": "admin/settings/turnstile",
                    "role": null
                }
            ]
        },
        "routes": {
            "admin/settings/turnstile": {
                "controller": "controllers/TurnstileController.php",
                "class": "Osmium\\Services\\Turnstile\\Controllers\\TurnstileController",
                "method": "index",
                "title": "Cloudflare Turnstile"
            }
        }
    },

    "frontend": {
        "themeBlocks": [
            {
                "hook": "head",
                "file": "theme/turnstile-headscript.phtml"
            }
        ]
    },

    "setup": {
        "postInstallNote": "Disabled by default. Once enabled with the keys from Cloudflare, every form that fires the form.verify and form.widget hooks (such as the product review form) is protected, with no per-form setup. A theme must echo $template['serviceHeadHtml'] in its <head> so the widget script loads. Other forms can call TurnstileConfig::verify($_POST['cf-turnstile-response'] ?? '') directly. The Turnstile settings page shows how many checks passed and failed."
    }
}
